{
  "compilerOptions": {
    "target": "ES2016", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "types": ["node"], "lib": ["ES2022", "DOM"], "declaration": false, "sourceMap": true
  },
  "include": ["src/**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
